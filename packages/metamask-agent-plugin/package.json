{
  "name": "@flurbo/metamask-agent-plugin",
  "version": "1.1.0",
  "description": "MetaMask Agent Wallet plugin for Flurbo prediction markets on Monad testnet",
  "type": "module",
  "files": ["dist", "oclif.manifest.json", "skills"],
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/snapshot-markets.mjs && oclif manifest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test"
  },
  "keywords": [
    "metamask",
    "agent-wallet",
    "plugin",
    "prediction-market",
    "monad",
    "lmsr"
  ],
  "author": "Flurbo Team",
  "license": "MIT",
  "oclif": { "bin": "mm", "commands": "./dist/commands", "topicSeparator": " " },
  "mm": {
    "schemaVersion": 1,
    "minCliVersion": ">=6.2.0",
    "capabilities": [],
    "commands": [
      { "id": "flurbo:quote", "capabilities": [], "dataAccess": [], "targetChains": [10143] },
      { "id": "flurbo:markets", "capabilities": [], "dataAccess": [], "targetChains": [10143] },
      { "id": "flurbo:holdings", "capabilities": ["wallet-read"], "dataAccess": ["accounts"], "targetChains": [10143] },
      { "id": "flurbo:trade", "capabilities": ["wallet-read", "wallet-submit"], "dataAccess": ["accounts"], "targetChains": [10143] },
      { "id": "flurbo:redeem", "capabilities": ["wallet-read", "wallet-submit"], "dataAccess": ["accounts"], "targetChains": [10143] }
    ]
  },
  "peerDependencies": {
    "@metamask/agent-wallet": ">=6.2.0"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@metamask/agent-wallet": "^7.0.0",
    "@types/node": "^22.0.0",
    "oclif": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
