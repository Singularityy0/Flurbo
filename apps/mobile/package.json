{
  "name": "@flurbo/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/network.test.ts scripts/passkey-config.test.cjs",
    "passkeys:association": "node scripts/generate-passkey-association.cjs",
    "export:native": "expo export --platform all",
    "prebuild": "expo prebuild --no-install"
  },
  "dependencies": {
    "expo": "57.0.24",
    "expo-crypto": "57.0.3",
    "expo-dev-client": "57.0.19",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0"
  },
  "devDependencies": {
    "@types/react": "19.2.4",
    "react-dom": "19.2.3",
    "react-native-web": "0.21.2",
    "typescript": "6.0.3"
  }
}
